# Every setting the site's functions read. Put the real values in the Vercel project
# (Settings → Environment Variables), then redeploy. To try things on this computer, copy this
# file to .env.local (never committed: *.local is in .gitignore) and fill it in.
# Never put real values in this file.

# ---- Admin login ----
ADMIN_PASSCODE=
GITHUB_TOKEN=

# ---- Payments ----
# Stripe: Dashboard → Developers → API keys (sk_test_... while testing, sk_live_... when real)
STRIPE_SECRET_KEY=
# Stripe → Developers → Webhooks → endpoint https://<site>/api/stripe-webhook, events
# checkout.session.completed, checkout.session.async_payment_succeeded, charge.refunded (whsec_...)
STRIPE_WEBHOOK_SECRET=
# PayPal: developer.paypal.com → Apps & Credentials (Sandbox while testing)
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# empty while testing (PayPal sandbox); "live" once the keys are real ones
PAYPAL_ENV=

# ---- Customer accounts (MongoDB) ----
# MongoDB Atlas → Connect → Drivers. This site shares the cluster with DarkBeats but keeps to its
# own database, "miltona", with its own database user milton-app (readWrite on miltona only):
# mongodb+srv://milton-app:<password>@testcluster.tbbqflh.mongodb.net/?appName=TestCluster
MONGODB_URI=
# the database's name; "miltona" when empty
MONGODB_DB=miltona

# ---- Emails (confirm your email, reset your password) ----
# Either an email account's sending server (SMTP), e.g. Gmail with an app password
# (Google Account → Security → 2-Step Verification → App passwords):
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
# or Resend (resend.com → API Keys), sending from a domain verified there:
RESEND_API_KEY=
# the sender as people see it, for example: Milton Aguiar <contact@miltonaguiar.com>
MAIL_FROM=
# optional: the name at the top of the emails (the site's name when empty)
MAIL_BRAND=
# optional: where replies to these emails go
MAIL_REPLY_TO=
# optional: where Contact and Commission messages go (the email in Site → Name, colour and contact when empty)
CONTACT_TO=
# optional: where the "new order" emails go (CONTACT_TO, then that same contact email, when empty)
ORDER_EMAIL_TO=

# ---- The site's address, for links in emails ----
# for example https://miltonaguiar.vercel.app (or its own domain once it has one)
SITE_URL=
