{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "redirects": [
    { "source": "/admin", "destination": "/admin/", "permanent": false }
  ],
  "rewrites": [
    { "source": "/api/gh/:path*", "destination": "/api/gh" },
    { "source": "/((?!api/|admin/).*)", "destination": "/index.html" }
  ],
  "functions": {
    "api/checkout.js": { "includeFiles": "content/**" },
    "api/paypal.js": { "includeFiles": "content/**" },
    "api/account.js": { "includeFiles": "content/**", "maxDuration": 60 },
    "api/commissions.js": { "includeFiles": "content/**", "maxDuration": 60 },
    "api/stripe-webhook.js": { "includeFiles": "content/**" },
    "api/orders.js": { "includeFiles": "content/work/**" },
    "api/contact.js": { "includeFiles": "content/site/**" }
  }
}
